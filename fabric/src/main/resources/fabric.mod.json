{
  "schemaVersion": 1,
  "id": "alltranslator",
  "version": "${version}",
  "name": "All Translator",
  "description": "Translates Minecraft, mod language files, items, tooltips, blocks, entities, UI, chat and FTB Quests text using user-configured external translation APIs.",
  "authors": [
    "29kiyo"
  ],
  "contact": {
    "homepage": "https://github.com/29kiyo/alltranslator",
    "sources": "https://github.com/29kiyo/alltranslator"
  },
  "license": "TBD",
  "icon": "assets/alltranslator/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kiyo.alltranslator.fabric.AllTranslatorFabric"
    ],
    "client": [
      "com.kiyo.alltranslator.fabric.client.AllTranslatorFabricClient"
    ],
    "modmenu": [
      "com.kiyo.alltranslator.fabric.client.AllTranslatorModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "com.kiyo.alltranslator.compat.jei.AllTranslatorJeiPlugin"
    ]
  },
  "mixins": [
    "alltranslator.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "architectury": ">=21.0.7",
    "fabric-api": "*"
  }
}
